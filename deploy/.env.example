# Copy to deploy/.env (`make deploy-env` does it and fills the secrets).
# Defaults run the whole stack on http://localhost for testing (hence COOKIE_SECURE=false).

DOMAIN=localhost
PUBLIC_WEB_URL=http://localhost
LIVEKIT_PUBLIC_URL=ws://localhost:7880
COOKIE_SECURE=false
ALLOW_GUEST_CREATE=true
# Origins allowed to iframe /embed/* (space-separated), baked into the web image at build.
# Unset = only this site. List your integrators, e.g. https://app.example.com
# EMBED_ALLOWED_ORIGINS=

# Secrets: generated by `make deploy-env`. Never reuse the dev ones.
POSTGRES_PASSWORD=change-me
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# ---- Production (HTTPS) — see docs/deploy.md ----
# DOMAIN=meet.example.com
# RTC_DOMAIN=rtc.example.com
# PUBLIC_WEB_URL=https://meet.example.com
# LIVEKIT_PUBLIC_URL=wss://rtc.example.com
# COOKIE_SECURE=true
# ENTRYPOINT=websecure
# ACME_EMAIL=you@example.com
# LIVEKIT_WS_BIND=127.0.0.1:7880
# LIVEKIT_USE_EXTERNAL_IP=true
# LIVEKIT_NODE_IP=
# TURN_ENABLED=true
# TURN_DOMAIN=rtc.example.com
