# Copy to .env for local development: `cp .env.example .env`
# The Makefile loads .env automatically. Values below work with `make infra-up`
# (Docker Postgres/Redis) and `make dev-livekit` (LiveKit in dev mode).

# --- API server ---
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://turtlemeet:turtlemeet@localhost:5432/turtlemeet
REDIS_URL=redis://127.0.0.1:6379
DB_MAX_CONNECTIONS=20
# Secure cookies are only sent over HTTPS. Must be true in production;
# false here because local development runs on http://localhost.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
RUST_LOG=info,server=debug
# Let visitors create meetings without an account (Jitsi-style). Creator becomes host.
ALLOW_GUEST_CREATE=true

# --- LiveKit ---
# Secrets stay server-side; browsers only receive short-lived, room-scoped tokens.
# devkey/secret are the well-known `livekit-server --dev` credentials: NEVER use in production.
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Web (Next.js) ---
# Next.js proxies /api/* here so the session cookie stays same-origin.
API_URL=http://127.0.0.1:8080

# --- Tests ---
# Separate database; integration tests insert rows (unique emails) and never truncate.
TEST_DATABASE_URL=postgres://turtlemeet:turtlemeet@localhost:5432/turtlemeet_test
