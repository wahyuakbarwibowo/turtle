# Server
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://turtlemeet:turtlemeet@localhost:5432/turtlemeet
REDIS_URL=redis://127.0.0.1:6379
DB_MAX_CONNECTIONS=20
# Set to false only for local http:// development.
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
RUST_LOG=info,server=debug

# Integration tests (separate DB; tests insert rows with unique emails)
TEST_DATABASE_URL=postgres://turtlemeet:turtlemeet@localhost:5432/turtlemeet_test

# LiveKit (secrets stay server-side; browsers only get short-lived join tokens)
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
